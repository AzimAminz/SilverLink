        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/send_verification_button" android:text="@string/send_for_verification" style="@style/SL.Button" app:icon="@drawable/task_send" android:layout_marginTop="20dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
