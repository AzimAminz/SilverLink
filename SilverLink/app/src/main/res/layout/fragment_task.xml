                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/task_clock3" android:contentDescription="@null" android:importantForAccessibility="no" android:layout_marginEnd="10dp" />
                    <TextView android:text="@string/today_4_00_5_00_pm" style="@style/SL.Text.Label" android:id="@+id/task_when" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="14dp" android:baselineAligned="false">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/task_map_pin" android:contentDescription="@null" android:importantForAccessibility="no" android:layout_marginEnd="10dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                        <TextView android:text="@string/label_18_cedar_lane_damai_township" style="@style/SL.Text.Label" android:id="@+id/task_location" />
                        <TextView android:text="@string/asha_s_home_address_shared_after_acceptance" style="@style/SL.Text.Caption" android:layout_marginTop="4dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp" android:baselineAligned="false">
                    <TextView android:text="@string/requested_by_priya_daughter" style="@style/SL.Text.BodyMuted" android:layout_width="0dp" android:layout_weight="1" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/task_chat_button" android:text="@string/chat" style="@style/SL.Button.Link" app:icon="@drawable/task_message_circle" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:text="@string/priya_s_instructions" style="@style/SL.Text.Label" android:layout_marginTop="20dp" />
