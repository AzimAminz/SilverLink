                <com.google.android.material.textfield.TextInputEditText android:id="@+id/completion_notes" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/collected_order_df218_and_put_the_bags_on_asha_s_kitchen_counter" android:hint="" android:textColor="@color/sl_ink" android:textSize="16sp" android:fontFamily="sans-serif" android:inputType="textCapSentences|textMultiLine" android:gravity="top" android:maxLines="4" android:padding="14dp" />
            </com.google.android.material.textfield.TextInputLayout>
