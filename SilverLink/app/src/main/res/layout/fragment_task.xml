                        <com.google.android.material.button.MaterialButton android:id="@+id/replace_photo_button" android:text="@string/replace_photo" style="@style/SL.Button.Link" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/completion_confirmed" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/i_completed_the_agreed_task_and_asha_received_the_help" android:textColor="@color/sl_ink" android:textSize="14sp" android:checked="false" android:layout_marginTop="14dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/bg_sand" android:layout_marginTop="16dp" android:baselineAligned="false">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/task_hourglass" android:contentDescription="@null" android:importantForAccessibility="no" android:layout_marginEnd="12dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
