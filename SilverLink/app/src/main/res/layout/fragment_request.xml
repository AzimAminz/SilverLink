<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="12dp" android:paddingBottom="24dp">
        <TextView android:text="@string/what_would_make_today_easier" style="@style/SL.Text.CardTitle" />
        <TextView android:text="@string/non_medical_help_from_verified_neighbours_in_damai_township" style="@style/SL.Text.BodyMuted" android:layout_marginTop="5dp" />
        <TextView android:text="@string/who_needs_a_hand" style="@style/SL.Text.Label" android:layout_marginTop="20dp" />
        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/recipient_toggle" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" app:checkedButton="@id/recipient_parent" android:layout_marginTop="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/recipient_self" android:text="@string/myself" android:layout_width="0dp" android:layout_weight="1" style="@style/SL.Button.Secondary" app:cornerRadius="24dp" app:backgroundTint="@color/segmented_background" android:textColor="@color/segmented_text" />
            <com.google.android.material.button.MaterialButton android:id="@+id/recipient_parent" android:text="@string/my_parent" android:layout_width="0dp" android:layout_weight="1" style="@style/SL.Button.Secondary" app:cornerRadius="24dp" app:backgroundTint="@color/segmented_background" android:textColor="@color/segmented_text" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <TextView android:text="@string/asha_menon_you_re_an_authorised_family_member" android:id="@+id/recipient_description" style="@style/SL.Text.Caption" android:layout_marginTop="9dp" />
        <TextView android:text="@string/choose_a_category" style="@style/SL.Text.Label" android:layout_marginTop="20dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="5dp" android:baselineAligned="false">
            <com.google.android.material.button.MaterialButton android:id="@+id/category_errands" android:text="@string/errands_40_pts_standard" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="4dp" android:textSize="14sp" android:minHeight="64dp" app:cornerRadius="12dp" app:iconSize="22dp" android:paddingStart="12dp" android:paddingEnd="12dp" style="@style/SL.Button.Secondary" app:icon="@drawable/request_shopping_bag" android:gravity="start|center_vertical" android:textAlignment="viewStart" app:iconGravity="start" />
            <com.google.android.material.button.MaterialButton android:id="@+id/category_companionship" android:text="@string/companionship_30_pts_standard" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="4dp" android:textSize="14sp" android:minHeight="64dp" app:cornerRadius="12dp" app:iconSize="22dp" android:paddingStart="12dp" android:paddingEnd="12dp" style="@style/SL.Button.Secondary" app:icon="@drawable/request_coffee" android:gravity="start|center_vertical" android:textAlignment="viewStart" app:iconGravity="start" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
            <com.google.android.material.button.MaterialButton android:id="@+id/category_household" android:text="@string/light_household_50_pts_standard" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="4dp" android:textSize="14sp" android:minHeight="64dp" app:cornerRadius="12dp" app:iconSize="22dp" android:paddingStart="12dp" android:paddingEnd="12dp" style="@style/SL.Button.Secondary" app:icon="@drawable/request_house" android:gravity="start|center_vertical" android:textAlignment="viewStart" app:iconGravity="start" />
            <com.google.android.material.button.MaterialButton android:id="@+id/category_digital" android:text="@string/digital_help_30_pts_standard" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="4dp" android:textSize="14sp" android:minHeight="64dp" app:cornerRadius="12dp" app:iconSize="22dp" android:paddingStart="12dp" android:paddingEnd="12dp" style="@style/SL.Button.Secondary" app:icon="@drawable/request_smartphone" android:gravity="start|center_vertical" android:textAlignment="viewStart" app:iconGravity="start" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="20dp">
            <TextView android:text="@string/task_title" android:labelFor="@id/request_title" style="@style/SL.Text.Label" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:hintEnabled="false" app:boxBackgroundMode="outline" app:boxBackgroundColor="@color/sl_surface" app:boxStrokeColor="@color/input_stroke" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" android:layout_marginTop="8dp" app:boxStrokeWidth="1dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/request_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/collect_prepaid_groceries" android:hint="" android:textColor="@color/sl_ink" android:textSize="16sp" android:fontFamily="sans-serif" android:inputType="textCapSentences" android:gravity="center_vertical" android:maxLines="1" android:padding="14dp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <TextView android:text="@string/when" style="@style/SL.Text.Label" android:layout_marginTop="20dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/request_when" android:text="@string/today_14_oct_4_00_5_00_pm" app:cornerRadius="12dp" app:iconGravity="start" android:textSize="14sp" style="@style/SL.Button.Secondary" app:icon="@drawable/request_calendar_days" android:layout_marginTop="8dp" android:gravity="start|center_vertical" android:textAlignment="viewStart" android:paddingStart="12dp" android:paddingEnd="12dp" />
        <TextView android:text="@string/help_location" style="@style/SL.Text.Label" android:layout_marginTop="20dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/request_location" android:text="@string/mum_s_home_18_cedar_lane" app:cornerRadius="12dp" app:iconGravity="start" android:textSize="14sp" style="@style/SL.Button.Secondary" app:icon="@drawable/request_map_pin" android:layout_marginTop="8dp" android:gravity="start|center_vertical" android:textAlignment="viewStart" android:paddingStart="12dp" android:paddingEnd="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="20dp">
            <TextView android:text="@string/what_does_your_neighbour_need_to_know" android:labelFor="@id/request_notes" style="@style/SL.Text.Label" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:hintEnabled="false" app:boxBackgroundMode="outline" app:boxBackgroundColor="@color/sl_surface" app:boxStrokeColor="@color/input_stroke" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" android:layout_marginTop="8dp" app:boxStrokeWidth="1dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/request_notes" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/collect_prepaid_groceries_at_damai_fresh_order_df218_bring_bags_" android:hint="" android:textColor="@color/sl_ink" android:textSize="16sp" android:fontFamily="sans-serif" android:inputType="textCapSentences|textMultiLine" android:gravity="top" android:maxLines="4" android:padding="14dp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:background="@drawable/bg_sand" android:layout_marginTop="20dp" android:baselineAligned="false">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/request_award" android:contentDescription="@null" android:importantForAccessibility="no" android:layout_marginEnd="12dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                <TextView android:text="@string/errands_standard_40_points" android:id="@+id/points_policy" style="@style/SL.Text.Label" />
                <TextView android:text="@string/awarded_to_the_helper_only_after_you_verify_completion" style="@style/SL.Text.Caption" android:layout_marginTop="3dp" />
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/broadcast_button" android:text="@string/broadcast_request" style="@style/SL.Button" app:icon="@drawable/request_radio" android:layout_marginTop="20dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="top" android:layout_marginTop="20dp" android:baselineAligned="false">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/request_shield_check" android:contentDescription="@null" android:importantForAccessibility="no" android:layout_marginEnd="10dp" />
            <TextView android:text="@string/only_eligible_verified_damai_residents_are_notified_your_exact_a" style="@style/SL.Text.Caption" android:layout_width="0dp" android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
