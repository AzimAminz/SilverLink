<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="12dp" android:paddingBottom="24dp">
        <TextView android:text="@string/join_your_neighbourhood" style="@style/SL.Text.Title" />
        <TextView android:text="@string/a_little_help_starts_with_a_trusted_connection" style="@style/SL.Text.BodyMuted" android:layout_marginTop="8dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="28dp">
            <TextView android:text="@string/full_name" android:labelFor="@id/full_name" style="@style/SL.Text.Label" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:hintEnabled="false" app:boxBackgroundMode="outline" app:boxBackgroundColor="@color/sl_surface" app:boxStrokeColor="@color/input_stroke" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" android:layout_marginTop="8dp" app:boxStrokeWidth="1dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/full_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="" android:hint="@string/your_name" android:textColor="@color/sl_ink" android:textSize="16sp" android:fontFamily="sans-serif" android:inputType="textPersonName" android:gravity="center_vertical" android:maxLines="1" android:padding="14dp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">
            <TextView android:text="@string/email_address" android:labelFor="@id/email" style="@style/SL.Text.Label" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:hintEnabled="false" app:boxBackgroundMode="outline" app:boxBackgroundColor="@color/sl_surface" app:boxStrokeColor="@color/input_stroke" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" android:layout_marginTop="8dp" app:boxStrokeWidth="1dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/email" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="" android:hint="@string/you_example_com" android:textColor="@color/sl_ink" android:textSize="16sp" android:fontFamily="sans-serif" android:inputType="textEmailAddress" android:gravity="center_vertical" android:maxLines="1" android:padding="14dp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">
            <TextView android:text="@string/township" android:labelFor="@id/township" style="@style/SL.Text.Label" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:hintEnabled="false" app:boxBackgroundMode="outline" app:boxBackgroundColor="@color/sl_surface" app:boxStrokeColor="@color/input_stroke" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" android:layout_marginTop="8dp" app:boxStrokeWidth="1dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/township" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/damai_township" android:hint="" android:textColor="@color/sl_ink" android:textSize="16sp" android:fontFamily="sans-serif" android:inputType="textCapSentences" android:gravity="center_vertical" android:maxLines="1" android:padding="14dp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">
            <TextView android:text="@string/home_address" android:labelFor="@id/address" style="@style/SL.Text.Label" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:hintEnabled="false" app:boxBackgroundMode="outline" app:boxBackgroundColor="@color/sl_surface" app:boxStrokeColor="@color/input_stroke" app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp" android:layout_marginTop="8dp" app:boxStrokeWidth="1dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/address" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="" android:hint="@string/house_number_and_street" android:textColor="@color/sl_ink" android:textSize="16sp" android:fontFamily="sans-serif" android:inputType="textPostalAddress" android:gravity="center_vertical" android:maxLines="1" android:padding="14dp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <TextView android:text="@string/how_would_you_like_to_use_silverlink" style="@style/SL.Text.Label" android:layout_marginTop="16dp" />
        <RadioGroup android:id="@+id/signup_role" android:layout_width="match_parent" android:layout_height="wrap_content" android:checkedButton="@id/role_requester" android:layout_marginTop="8dp">
            <RadioButton android:id="@+id/role_requester" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/request_help_for_myself_or_my_parent" />
            <RadioButton android:id="@+id/role_helper" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/help_neighbours_in_my_township" />
        </RadioGroup>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="top" android:layout_marginTop="20dp" android:baselineAligned="false">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/request_shield_check" android:contentDescription="@null" android:importantForAccessibility="no" android:layout_marginEnd="10dp" />
            <TextView android:text="@string/this_preview_uses_local_demo_data_resident_identity_checks_will_" style="@style/SL.Text.Caption" android:layout_width="0dp" android:layout_weight="1" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/create_profile_button" android:text="@string/create_demo_profile" style="@style/SL.Button" android:layout_marginTop="20dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
